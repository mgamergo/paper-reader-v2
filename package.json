{
  "name": "paper-reader-v2",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun --env-file=.env.local test tests/unit tests/integration",
    "test:e2e": "playwright test",
    "eval:rag": "bun scripts/eval-rag.ts",
    "local": "bash scripts/dev-local.sh",
    "postinstall": "bun scripts/prepare-assets.ts",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun --env-file=.env.local test tests/integration"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.25",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.49.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.71.0",
    "next": "^16.4.6",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.6",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "6"
  }
